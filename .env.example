# Milestone 1 external services
OPENAI_API_KEY=
TAVILY_API_KEY=
AGENT_MODEL=gpt-4.1-mini
SYNTHESIS_MODEL=gpt-4.1
SEARCH_RESULTS_PER_AGENT=5
AGENT_TIMEOUT_SECONDS=20
AGENT_MAX_TOKENS=1200
RECENT_NEWS_DAYS=30

# Consensus defaults (used from Milestones 2 and 7)
CONFIDENCE_WEIGHT_AGREEMENT=0.35
CONFIDENCE_WEIGHT_SOURCE_QUALITY=0.25
CONFIDENCE_WEIGHT_INDEPENDENCE=0.20
CONFIDENCE_WEIGHT_RECENCY=0.10
CONFIDENCE_WEIGHT_CONTRADICTION=0.10
CONFIDENCE_THRESHOLD_HIGH=0.75
CONFIDENCE_THRESHOLD_MEDIUM=0.50

# Application services (used from Milestones 3 onward)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@postgres:5432/research
REDIS_URL=redis://redis:6379/0
REDIS_CACHE_TTL_SECONDS=3600
RATE_LIMIT_JOBS=10
RATE_LIMIT_WINDOW_SECONDS=3600
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
SESSION_SECRET=
SESSION_TTL_SECONDS=86400
APP_ENV=development
ALLOW_DEV_AUTH=true
API_BASE_URL=http://fastapi:8000
GOOGLE_REDIRECT_URI=http://localhost:8501

# Optional bearer session used by the evaluation runner
EVALUATION_BEARER_TOKEN=
